# Required — Claude Code uses this to authenticate in non-interactive (Docker) mode
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Optional — scraper auto-login during Extract Contract (values never sent to LLM; only key names)
# QA_LOGIN_URL = the real login page for the site you are scraping (same app as the Extract Contract URL).
# When set, the scraper always opens this page to enter QA_USERNAME/QA_PASSWORD or QA_TEST_MOBILE/QA_TEST_OTP.
QA_LOGIN_URL=https://yourapp.com/login
QA_USERNAME=admin@yourapp.com
QA_PASSWORD=yourpassword

# Phone + OTP flow: set QA_LOGIN_URL, QA_TEST_MOBILE, QA_TEST_OTP
QA_TEST_MOBILE=          # phone/mobile enrolled in the target QA environment
QA_TEST_OTP=             # fixed/static OTP for that test account (ask the env owner)

# Optional — slow SPAs / QA environments (default 60000)
# QA_NAVIGATION_TIMEOUT_MS=90000

# Optional — max no-href button clicks per page during scrape (default 30, 0 disables)
# QA_BUTTON_PROBE_LIMIT=30

# Backend (set automatically in Docker)
# QA_DATA_ROOT=/data
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

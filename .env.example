# Required — Claude Code uses this to authenticate in non-interactive (Docker) mode
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Optional — scraper login for protected pages (CLI flags also supported)
QA_LOGIN_URL=https://yourapp.com/login
QA_USERNAME=admin@yourapp.com
QA_PASSWORD=yourpassword

# QA test credentials for dristi-kerala (OTP-based login)
QA_BASE_URL=https://dristi-kerala-qa.pucar.org
QA_TEST_MOBILE=          # 10-digit mobile number enrolled in the QA environment
QA_TEST_OTP=             # fixed/static OTP for the QA test mobile (ask the QA env owner)

# Backend (set automatically in Docker)
# QA_DATA_ROOT=/data
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
